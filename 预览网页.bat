@echo off
chcp 65001 >nul
rem ============================================================
rem  预览网页.bat -- 双击本文件即可在浏览器里查看网页效果
rem  不依赖任何服务器，也不需要联网。
rem ============================================================
cd /d "%~dp0"

echo.
echo   正在打开网页预览...
echo.
echo   如果浏览器没有自动弹出，请手动双击本目录下的 index.html。
echo.

start "" "%~dp0index.html"
exit /b 0
